# ===== 复制为 .env 后填写（.env 已被 .gitignore 忽略，不会上传）=====
# 系统不默认指向任何平台：配置缺失时对应 step 直接报错退出。
# 值含 # 时请用引号包裹整个值；行内注释用 " #" 分隔。

# ---- 测试器（step4 测试被测模型用）----
TEST_API_KEY=
TEST_MODEL=
TEST_BASE_URL=

# ---- 自然语言化（step3 用）----
NL_API_KEY=
NL_MODEL=
NL_BASE_URL=

# ---- 公共兜底（TEST_*/NL_* 未填时回落到这两个）----
DEFAULT_MODEL=
DEFAULT_BASE_URL=
